{
  "version": 2,
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    {
      "source": "/auth",
      "destination": "/auth.html"
    },
    {
      "source": "/download",
      "destination": "/downloads/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Permissions-Policy",
          "value": "autoplay=*"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ],
  "redirects": [
    { "source": "/landing", "destination": "/about", "permanent": true },
    { "source": "/landing/", "destination": "/about/", "permanent": true },
    {
      "source": "/windows",
      "destination": "https://apps.microsoft.com/detail/9P4W2JHQ03N1",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://play.google.com/store/apps/details?id=com.dcode9.dtunes",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "tunes.dverse.fun" }
      ],
      "destination": "https://tunes.d-verse.in/:path*",
      "permanent": true
    }
  ]
}
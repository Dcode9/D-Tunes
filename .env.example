# Server Configuration
PORT=3000

# D-Verse / Supabase (public client identifiers; never commit service-role or private keys)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<public-anon-or-publishable-key>

# Server-side AI curation proxy (algorithmic fallback is used when unavailable)
AI_ENDPOINT=https://ai.d-verse.in/api/chat
AI_MODEL=mercury-3
AI_PROVIDER=inception

# Opt-in server behavior flags (set to true/1 only when supported/configured)
# DTUNES_REQUIRE_AUTH=false
# DTUNES_REMOTE_TASTE=false
